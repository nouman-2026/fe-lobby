# Shared / production defaults — copy to `.env`
# Nuxt loads this for `build` / `preview`. Dev uses `.env.development` instead.
NUXT_PUBLIC_CDN_URL=https://cdn.ninjagaming.org/storage

# Local development — see `.env.development` (loaded by `npm run dev`):
# NUXT_PUBLIC_API_BASE=https://demo.ninjagaming.com/lobby/api
# NUXT_PUBLIC_CDN_URL=https://cdn.ninjagaming.org/storage
